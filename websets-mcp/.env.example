# Exa — semantic search engine (https://exa.ai)
EXA_API_KEY=your_exa_api_key

# Anthropic — Claude API for query generation and entity extraction
ANTHROPIC_API_KEY=your_anthropic_api_key

# HubSpot — CRM sync (optional, needed for push_to_hubspot)
HUBSPOT_API_KEY=your_hubspot_api_key

# Google Sheets — export (optional, needed for export_to_sheets)
# Paste the full JSON contents of your service account key file
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
